diff --git a/src/dev/build/lib/extraLaunchpadOptions.ts b/src/dev/build/lib/extraLaunchpadOptions.ts
new file mode 100644
index 0000000000..211fdcc2e3
--- /dev/null
+++ b/src/dev/build/lib/extraLaunchpadOptions.ts
@@ -0,0 +1,34 @@
+import { HttpsProxyAgent } from 'https-proxy-agent';
+
+export function extraLaunchpadOptions() {
+  if (!process.env.PROXYHOST) {
+    throw new Error('Missing PROXYHOST environment variable.');
+  }
+
+  if (!process.env.ARTIFACTORY_USER) {
+    throw new Error('Missing ARTIFACTORY_USER environment variable.');
+  }
+
+  if (!process.env.ARTIFACTORY_PASSWORD) {
+    throw new Error('Missing ARTIFACTORY_PASSWORD environment variable.');
+  }
+
+  const proxyUrl = process.env.PROXYHOST.startsWith('http')
+    ? process.env.PROXYHOST
+    : `http://${process.env.PROXYHOST}`;
+
+  console.log(`HTTPS proxy is set to: ${proxyUrl}`);
+  const proxyAgent = new HttpsProxyAgent(proxyUrl);
+
+  const auth = `${process.env.ARTIFACTORY_USER}:${process.env.ARTIFACTORY_PASSWORD}`;
+  const encodedAuth = Buffer.from(auth).toString('base64');
+
+  const options = {
+    httpsAgent: proxyAgent,
+    headers: {
+      Authorization: `Basic ${encodedAuth}`,
+    },
+  };
+
+  return options;
+}
