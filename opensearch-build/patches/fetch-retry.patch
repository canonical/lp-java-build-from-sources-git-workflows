--- a/src/git/git_repository.py
+++ b/src/git/git_repository.py
@@ -8,6 +8,7 @@
 import logging
 import os
 import subprocess
+import time
 from pathlib import Path
 from typing import Any, List
 
@@ -46,7 +47,19 @@ class GitRepository:
     def __checkout__(self) -> None:
         self.execute_silent("git init", self.dir)
         self.execute_silent(f"git remote add origin {self.url}", self.dir)
-        self.execute_silent(f"git fetch --depth 1 origin {self.ref}", self.dir)
+        # retry as launchpad can hang sometimes
+        fetch_cmd = f"git fetch --depth 1 origin {self.ref}"
+        retries = 3
+        for attempt in range(1, retries + 1):
+            try:
+                self.execute_silent(fetch_cmd, self.dir)
+                break
+            except subprocess.CalledProcessError:
+                if attempt >= retries:
+                    raise
+                sleep_time = attempt * 45
+                logging.warning(f"Fetch failed, retrying in {sleep_time}s...")
+                time.sleep(sleep_time)
         self.execute_silent("git checkout FETCH_HEAD", self.dir)
         self.sha = self.output("git rev-parse HEAD", self.dir)
         logging.info(f"Checked out {self.url}@{self.ref} into {self.dir} at {self.sha}")
