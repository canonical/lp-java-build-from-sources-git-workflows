pipeline:
  - prepare
  - build
  - assemble
  # - test
  - release

jobs:
  prepare:
    series: noble
    architectures:
      - amd64
      - arm64
    environment:
      BASE_BUILD_DIR: /home/opensearch/opensearch-build
    package-repositories:
      - type: apt
        ppa: smethnani/python3-jproperties
        trusted: true
    packages:
      - build-essential
      - cmake
      - gfortran
      - git
      - libomp-dev
      - libopenblas-pthread-dev
      - libgflags-dev
      - libssl-dev
      - lptools
      - openjdk-21-jdk-headless
      - python3-jproperties
      - python3-cerberus
      - python3-launchpadlib
      - python3-psutil
      - python3-requests
      - python3-sortedcontainers
      - python3-validators
      - python3-yaml
      - python3-semver
      - zip
      - zlib1g-dev
      # Used for nmslib:
      # https://github.com/opensearch-project/k-NN/blob/6203ba1c8b2f430c2558ac2d69128644b6e5ee88/scripts/build.sh#L138
      - gcc-10
      - g++-10
      - gfortran-10
    snaps:
      - name: yq
        channel: latest/stable  # Assemble stage now needs yq v4+

    run: |-
      echo -e "\n\n\n\n##################################\n\n\n\n"
      echo -e "\nPreparing environment..."

      apt-get update; apt-get upgrade -y

      # create opensearch user
      id -u opensearch >/dev/null 2>&1 || groupadd -g 1000 opensearch
      id -u opensearch >/dev/null 2>&1 || adduser -uid 1000 -gid 1000 --disabled-password --gecos "" opensearch
      chown -R opensearch:opensearch "${PWD}"

      # create opensearch-build
      su -l -c "mkdir -p opensearch-build" opensearch

      # move current project to the opensearch home dir 
      mv_src_cmd="shopt -s dotglob; mkdir -p ~/.gradle; mv ${PWD}/* ${BASE_BUILD_DIR}/"
      su -l -c "${mv_src_cmd}" opensearch

      # copy gradle repo conf
      su -l -c "mkdir -p ~/.gradle; cp ${BASE_BUILD_DIR}/lp-management-scripts/init.gradle ~/.gradle" opensearch

      # Used for nmslib:
      # https://github.com/opensearch-project/k-NN/blob/6203ba1c8b2f430c2558ac2d69128644b6e5ee88/scripts/build.sh#L138
      ln -s /usr/bin/gcc-10 /usr/bin/gcc10-gcc
      ln -s /usr/bin/g++-10 /usr/bin/gcc10-g++
      ln -s /usr/bin/gfortran-10 /usr/bin/gcc10-gfortran

  build:
    series: noble
    architectures:
      - amd64
      - arm64
    environment:
      OPENSEARCH_VERSION: ${VERSION}
      ARTIFACTORY_URL: "https://canonical.jfrog.io/artifactory/dataplatform-opensearch-staging"
      BASE_BUILD_DIR: /home/opensearch/opensearch-build
      no_proxy: localhost
      https_proxy: 10.10.10.1:8222
      http_proxy: 10.10.10.1:8222
      _JAVA_OPTIONS: '-Dhttp.proxyHost=10.10.10.1 -Dhttp.proxyPort=8222 -Dhttps.proxyHost=10.10.10.1 -Dhttps.proxyPort=8222 -Dhttp.nonProxyHosts=localhost'
    run: |-
      set -o pipefail

      ARCH=$(dpkg --print-architecture)
      export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-${ARCH}

      echo -e "\n\n\n\n##################################\n\n\n\n"
      echo -e "\nBuilding OpenSearch & Plugins..."

      # we occasionally hit 500 server unavailable errors that could be retried
      retry() {
        local logfile=/tmp/build-output.log
        for attempt in 1 2 3; do
          "$@" 2>&1 | tee "$logfile" && return 0
          grep -qiE 'status code 50[0-4]|Internal Server Error|Service Unavailable' "$logfile" || return 1
          if [ "$attempt" -lt 3 ]; then
            echo "(attempt $attempt) Server unavailable error, retrying in 30s..."
            sleep 30
          fi
        done
        return 1
      }

      # Set artifactory gradle wrapper credentials for downloading dependencies, plugins and the gradle distros from artifactory
      export ARTIFACTORY_USER="$(echo "${PIP_INDEX_URL#https://}" | awk -F '@' '{print $1}' | awk -F ':' '{print $1}')"
      export ARTIFACTORY_PASSWORD="$(echo "${PIP_INDEX_URL#https://}" | awk -F '@' '{print $1}' | awk -F ':' '{print $2}')"
      export GRADLE_OPTS="-Dgradle.wrapperUser=${ARTIFACTORY_USER} -Dgradle.wrapperPassword=${ARTIFACTORY_PASSWORD}"

      manifest="${BASE_BUILD_DIR}/manifests/${OPENSEARCH_VERSION}/opensearch-${OPENSEARCH_VERSION}.yml"
      cmd="pushd ${BASE_BUILD_DIR}/ && bash build.sh "${manifest}" && popd"
      retry su -c "${cmd}" opensearch

  assemble:
    series: noble
    architectures:
      - amd64
      - arm64
    environment:
      OPENSEARCH_VERSION: ${VERSION}
      ARTIFACTORY_URL: "https://canonical.jfrog.io/artifactory/dataplatform-opensearch-staging"
      BASE_BUILD_DIR: /home/opensearch/opensearch-build
      no_proxy: localhost
      https_proxy: 10.10.10.1:8222
      http_proxy: 10.10.10.1:8222
      _JAVA_OPTIONS: '-Dhttp.proxyHost=10.10.10.1 -Dhttp.proxyPort=8222 -Dhttps.proxyHost=10.10.10.1 -Dhttps.proxyPort=8222 -Dhttp.nonProxyHosts=localhost'
    run: |-
      ARCH=$(dpkg --print-architecture)
      export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-${ARCH}
      [[ "$ARCH" == "amd64" ]] && ARCH="x64"

      echo -e "\n\n\n\n##################################\n\n\n\n"
      echo -e "\nAssembling OpenSearch Distribution..."

      # Set artifactory gradle wrapper credentials for downloading dependencies, plugins and the gradle distros from artifactory 
      export ARTIFACTORY_USER="$(echo "${PIP_INDEX_URL#https://}" | awk -F '@' '{print $1}' | awk -F ':' '{print $1}')"
      export ARTIFACTORY_PASSWORD="$(echo "${PIP_INDEX_URL#https://}" | awk -F '@' '{print $1}' | awk -F ':' '{print $2}')"
      export GRADLE_OPTS="-Dgradle.wrapperUser=${ARTIFACTORY_USER} -Dgradle.wrapperPassword=${ARTIFACTORY_PASSWORD}"

      # assemble distribution and plugins
      manifest="${BASE_BUILD_DIR}/tar/builds/opensearch/manifest.yml"

      cmd="pushd ${BASE_BUILD_DIR}/ && cat ${manifest} && popd"
      su -c "${cmd}" opensearch

      cmd="pushd ${BASE_BUILD_DIR}/ && bash assemble.sh ${manifest} && popd"
      su -c "${cmd}" opensearch

      # add missing plugins
      tarball="opensearch-${OPENSEARCH_VERSION}-linux-${ARCH}.tar.gz"
      s3="${BASE_BUILD_DIR}/tar/builds/opensearch/core-plugins/repository-s3-${OPENSEARCH_VERSION}.zip"
      gcs="${BASE_BUILD_DIR}/tar/builds/opensearch/core-plugins/repository-gcs-${OPENSEARCH_VERSION}.zip"
      azure="${BASE_BUILD_DIR}/tar/builds/opensearch/core-plugins/repository-azure-${OPENSEARCH_VERSION}.zip"

      cmd="pushd ${BASE_BUILD_DIR}/tar/dist/opensearch/;
          tar -xzvf ${tarball};
          rm ${tarball};
          pushd opensearch-${OPENSEARCH_VERSION};
          bin/opensearch-plugin install -b file:${s3};
          bin/opensearch-plugin install -b file:${gcs};
          bin/opensearch-plugin install -b file:${azure};
          popd;
          tar -zcvf ${tarball} opensearch-${OPENSEARCH_VERSION};
          popd"
            
      su -c "${cmd}" opensearch

  test:
    series: noble
    architectures:
      - amd64
      - arm64
    environment:
      OPENSEARCH_VERSION: ${VERSION}
      ARTIFACTORY_URL: "https://canonical.jfrog.io/artifactory/dataplatform-opensearch-staging"
      BASE_BUILD_DIR: /home/opensearch/opensearch-build
      no_proxy: localhost
      https_proxy: 10.10.10.1:8222
      http_proxy: 10.10.10.1:8222
      _JAVA_OPTIONS: '-Dhttp.proxyHost=10.10.10.1 -Dhttp.proxyPort=8222 -Dhttps.proxyHost=10.10.10.1 -Dhttps.proxyPort=8222 -Dhttp.nonProxyHosts=localhost'
    run: |-
      ARCH=$(dpkg --print-architecture)
      export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-${ARCH}
      export OPENSEARCH_JAVA_HOME=${JAVA_HOME}

      echo -e "\n\n\n\n##################################\n\n\n\n"
      echo -e "\nRunning Integration tests for OpenSearch and plugins..."

      # Set artifactory gradle wrapper credentials for downloading dependencies, plugins and the gradle distros from artifactory 
      export ARTIFACTORY_USER="$(echo "${PIP_INDEX_URL#https://}" | awk -F '@' '{print $1}' | awk -F ':' '{print $1}')"
      export ARTIFACTORY_PASSWORD="$(echo "${PIP_INDEX_URL#https://}" | awk -F '@' '{print $1}' | awk -F ':' '{print $2}')"
      export GRADLE_OPTS="-Dgradle.wrapperUser=${ARTIFACTORY_USER} -Dgradle.wrapperPassword=${ARTIFACTORY_PASSWORD}"
      
      manifest="manifests/${OPENSEARCH_VERSION}/opensearch-${OPENSEARCH_VERSION}-test.yml"
      
      # run tests per component, so that we get the exact view on all the failing tests
      declare -a COMPONENTS=(
          OpenSearch k-NN 
      )
      for component in "${COMPONENTS[@]}"; do
        echo -e "\n\n\n${component}"
      
        cmd="pushd ${BASE_BUILD_DIR} && bash test.sh integ-test ${manifest} --paths opensearch=tar --component ${component} && popd"
        su -c "${cmd}" opensearch || true
      done

      project_root="${PWD}"
      pushd ${BASE_BUILD_DIR}
      zip -r test-results-${ARCH}.zip test-results || true
      mv test-results-${ARCH}.zip "${project_root}" || true
      popd
    output:
      paths:
        - test-results-*.zip

  release:
    series: noble
    architectures:
      - amd64
      - arm64
    environment:
      PATCH_NUMBER: 0
      OPENSEARCH_VERSION: ${VERSION}
      BASE_BUILD_DIR: /home/opensearch/opensearch-build
      no_proxy: localhost
      https_proxy: 10.10.10.1:8222
      http_proxy: 10.10.10.1:8222
    run: |-
      ARCH=$(dpkg --print-architecture)
      [[ "$ARCH" == "amd64" ]] && ARCH="x64"

      echo -e "\n\n\n\n##################################\n\n\n\n"
      echo -e "\nPublish the OpenSearch Tarball to Launchpad."

      timestamp="$(date +"%Y%m%d%H%M%S")"
      tarball="opensearch-${OPENSEARCH_VERSION}-ubuntu${PATCH_NUMBER}-${timestamp}-linux-${ARCH}.tar.gz"

      # copy the tarball to the launchpad build directory
      cp "${BASE_BUILD_DIR}/tar/dist/opensearch/opensearch-${OPENSEARCH_VERSION}-linux-${ARCH}.tar.gz" ./"${tarball}"

      # compute the checksum
      sha512sum "${tarball}" > "${tarball}.sha512"

      # .m2 repos
      project_root="${PWD}"
      pushd /home/opensearch/.m2
      zip -r repository-${ARCH}.zip repository
      mv repository-${ARCH}.zip "${project_root}"
      popd
    output:
      paths:
        - opensearch-*-linux-*.tar.gz
        - opensearch-*-linux-*.tar.gz.sha512
        - repository-*.zip
